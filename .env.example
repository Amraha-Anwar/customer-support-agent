# ---------------------------------------------------------------------------
# WhatsApp AI Ordering Backend — environment variables
# Copy this file to ".env" and fill in your real keys.
# ---------------------------------------------------------------------------

# OpenAI (GPT-4o)
OPENAI_API_KEY=sk-...

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Your Twilio WhatsApp sender, including the "whatsapp:" prefix.
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Deepgram (speech-to-text for voice notes)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs (text-to-speech for voice replies)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional: override the default voice (defaults to the stock "Rachel" voice).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Public URL of THIS server (needed so Twilio can fetch generated voice replies).
# When testing locally, expose port 8000 with ngrok and paste the https URL here.
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=
